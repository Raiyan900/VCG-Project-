MONGO_URI=mongodb://127.0.0.1:27017/datameridian
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
CLIENT_URL=http://localhost:5173

# Set local for development or cloud for production object storage.
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# S3-compatible object storage. Required when STORAGE_PROVIDER=cloud.
# Works with Amazon S3, Cloudflare R2, MinIO, and compatible providers.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=

# AI provider (OpenAI-compatible chat completions API). Leave AI_API_KEY empty
# to disable AI features — the API will respond with a clear "not configured" message.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

